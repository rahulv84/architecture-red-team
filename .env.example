# Architecture Red Team - local configuration.  Copy to ".env" and edit.
# Nothing in this file is required for the offline demo (DEMO_MODE=true).

# --- LLM provider: anthropic | openai | bedrock | mock -----------------------
LLM_PROVIDER=mock
DEMO_MODE=true

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# AWS Bedrock (uses the standard AWS credential chain / profile)
AWS_REGION=us-east-1
AWS_PROFILE=
# Bedrock API key (bearer token). When set it is used instead of AWS_PROFILE / the credential chain.
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# --- Workflow limits -----------------------------------------------------------
MAX_CONCURRENT_AGENTS=6
MAX_REVIEW_ROUNDS=3
MAX_INPUT_TOKENS=60000
MAX_OUTPUT_TOKENS=16000

# --- Local runtime -------------------------------------------------------------
LOCAL_DATA_DIR=data
FASTAPI_PORT=8000
STREAMLIT_PORT=8501

# --- Optional tuning -----------------------------------------------------------
# Simulated per-agent delay in offline demo mode (seconds) so progress is visible
MOCK_LATENCY_SECONDS=1.0
# Run Checkov when it is installed (otherwise reported as NOT_EXECUTED)
ENABLE_CHECKOV=true
# How many times an architect may dispute the same finding
MAX_DISPUTES_PER_FINDING=2
# Upload limits
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=200
