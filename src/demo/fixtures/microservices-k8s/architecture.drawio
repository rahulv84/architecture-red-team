<mxfile host="app.diagrams.net">
  <diagram id="payflow" name="PayFlow runtime view">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" page="1">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="merchant" value="Merchant / Mobile App" style="shape=actor;" vertex="1" parent="1"><mxGeometry x="20" y="200" width="80" height="60" as="geometry"/></mxCell>
        <mxCell id="ingress" value="Ingress Controller" style="rounded=1;" vertex="1" parent="1"><mxGeometry x="140" y="200" width="100" height="60" as="geometry"/></mxCell>
        <mxCell id="gateway" value="api-gateway (Kong)" style="rounded=1;" vertex="1" parent="1"><mxGeometry x="280" y="200" width="100" height="60" as="geometry"/></mxCell>
        <mxCell id="cluster" value="Kubernetes cluster" style="swimlane;container=1;" vertex="1" parent="1"><mxGeometry x="260" y="20" width="520" height="160" as="geometry"/></mxCell>
        <mxCell id="orders" value="orders-service" style="rounded=1;" vertex="1" parent="1"><mxGeometry x="440" y="120" width="100" height="50" as="geometry"/></mxCell>
        <mxCell id="payments" value="payments-service" style="rounded=1;" vertex="1" parent="1"><mxGeometry x="580" y="120" width="100" height="50" as="geometry"/></mxCell>
        <mxCell id="inventory" value="inventory-service" style="rounded=1;" vertex="1" parent="1"><mxGeometry x="440" y="260" width="100" height="50" as="geometry"/></mxCell>
        <mxCell id="notifications" value="notification-service" style="rounded=1;" vertex="1" parent="1"><mxGeometry x="720" y="260" width="100" height="50" as="geometry"/></mxCell>
        <mxCell id="postgres" value="PostgreSQL database" style="shape=cylinder3;" vertex="1" parent="1"><mxGeometry x="580" y="360" width="80" height="80" as="geometry"/></mxCell>
        <mxCell id="redis" value="Redis cache" style="shape=cylinder3;" vertex="1" parent="1"><mxGeometry x="300" y="360" width="80" height="80" as="geometry"/></mxCell>
        <mxCell id="kafka" value="Kafka event broker" style="rounded=1;" vertex="1" parent="1"><mxGeometry x="720" y="140" width="100" height="50" as="geometry"/></mxCell>
        <mxCell id="acquirer" value="External Payment Acquirer API" style="shape=cloud;" vertex="1" parent="1"><mxGeometry x="820" y="20" width="120" height="70" as="geometry"/></mxCell>
        <mxCell id="prom" value="Prometheus / Grafana" style="rounded=1;" vertex="1" parent="1"><mxGeometry x="140" y="360" width="110" height="50" as="geometry"/></mxCell>
        <mxCell id="e1" value="HTTPS" edge="1" parent="1" source="merchant" target="ingress"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="HTTP" edge="1" parent="1" source="ingress" target="gateway"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="REST" edge="1" parent="1" source="gateway" target="orders"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="REST" edge="1" parent="1" source="gateway" target="inventory"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="REST (synchronous)" edge="1" parent="1" source="orders" target="payments"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="HTTPS" edge="1" parent="1" source="payments" target="acquirer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="SQL" edge="1" parent="1" source="payments" target="postgres"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="SQL" edge="1" parent="1" source="orders" target="postgres"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="SQL" edge="1" parent="1" source="inventory" target="postgres"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="cache read/write" edge="1" parent="1" source="inventory" target="redis"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="publish order events" edge="1" parent="1" source="orders" target="kafka"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="consume events" edge="1" parent="1" source="kafka" target="notifications"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
